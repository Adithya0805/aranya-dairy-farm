# ─────────────────────────────────────────────────────────────────────────────
# Aranya Organic Dairy Farm — Environment Variables Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Production Website Domain (used in sitemaps, robots.txt, OpenGraph metadata)
NEXT_PUBLIC_SITE_URL=https://aranyaorganicdairyfarm.com

# Primary Business & Customer Email (Google Workspace / Gmail)
NEXT_PUBLIC_FARM_EMAIL=info@aranyaorganicdairyfarm.com

# Direct Farm WhatsApp Hotline Number (international format without +)
NEXT_PUBLIC_WHATSAPP_NUMBER=919944338612

# Comma-separated list of authorized Admin emails
ADMIN_EMAILS=admin@aranyaorganicdairyfarm.com,info@aranyaorganicdairyfarm.com

# Supabase Public Configuration (Optional - static fallback is active if omitted)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server Role Key (Server-side ONLY)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Low-Stock Alert Email (Optional) ─────────────────────────────────────────
# Resend API key for transactional email alerts (https://resend.com)
# If not set, alerts are logged to the server console only.
RESEND_API_KEY=re_your_resend_api_key_here

# Email address to receive low-stock alerts (defaults to NEXT_PUBLIC_FARM_EMAIL if not set)
ALERT_EMAIL=admin@aranyaorganicdairyfarm.com

